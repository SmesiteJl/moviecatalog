# Copy to .env and adjust. Every value below already has a working default,
# so the application runs without this file.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=moviecatalog
DB_USER=moviecatalog
DB_PASSWORD=moviecatalog

# offline (default) serves the bundled catalogue; http calls the real TMDB API.
TMDB_MODE=offline
TMDB_API_KEY=
# Some networks cannot reach TMDB directly; route through a local proxy if needed.
TMDB_PROXY_ENABLED=false
TMDB_PROXY_HOST=127.0.0.1
TMDB_PROXY_PORT=12334

ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@moviecatalog.local
ADMIN_PASSWORD=change-me
